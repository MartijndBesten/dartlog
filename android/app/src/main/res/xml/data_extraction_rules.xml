<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: zelfde regels voor cloudback-up en overzetten naar een nieuwe telefoon (zie backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="file" path="." />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
