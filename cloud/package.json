{
  "name": "okkie-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --test tests/*.test.js",
    "deploy:staging": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env production",
    "migrate:local": "wrangler d1 migrations apply okkie-community-staging --local",
    "migrate:staging": "wrangler d1 migrations apply okkie-community-staging --remote",
    "migrate:production": "wrangler d1 migrations apply okkie-community --remote --env production"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
