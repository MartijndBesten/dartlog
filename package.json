{
  "name": "okkie",
  "version": "1.3.2",
  "private": true,
  "description": "OKKIE — persoonlijke darttrainer (PWA) met scoretraining, 301/501 en statistieken",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "icons": "node tools/make-icons.mjs",
    "build:site": "node tools/build-public-site.mjs",
    "check:launch": "node tools/launch-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
